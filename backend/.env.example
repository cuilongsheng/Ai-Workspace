# Runtime
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_LOCALE=en-US

# Database and Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/ai_workspace
REDIS_URL=redis://localhost:6379

# Authentication - replace with independent random values in every environment
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters

# Development seed - never keep the fallback password in production
SEED_ADMIN_EMAIL=admin@ai-workspace.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-for-shared-environments
SEED_ORGANIZATION_NAME=Demo Organization

# Embeddings - current provider wiring uses Ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024

# LLM - current provider wiring uses a DeepSeek-compatible endpoint
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional reranker; retrieval falls back to Vector/BM25 evidence if unavailable
RERANKER_BASE_URL=http://127.0.0.1:8010
RERANKER_TIMEOUT_MS=30000

# Retrieval thresholds
RETRIEVAL_MIN_SIMILARITY=0.35
RETRIEVAL_MIN_RERANK_SCORE=0.15

# Optional OAuth placeholders
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_SUCCESS_REDIRECT_URL=http://localhost:5173
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_URL=http://localhost:3000/auth/wechat/callback
WECHAT_SUCCESS_REDIRECT_URL=http://localhost:5173
